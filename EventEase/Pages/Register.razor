@page "/register"
@inject SessionState Session

<PageTitle>Register</PageTitle>
<h1>Event Registration</h1>

<EditForm Model="Model" OnValidSubmit="Submit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <label>Name</label>
    <InputText @bind-Value="Model.Name" />

    <label>Email</label>
    <InputText @bind-Value="Model.Email" />

    <label>Event ID</label>
    <InputNumber @bind-Value="Model.EventId" />

    <button type="submit">Register</button>
</EditForm>

@if (!string.IsNullOrWhiteSpace(Message))
{
    <p class="success">@Message</p>
}

@code {
    private RegistrationModel Model { get; set; } = new();
    private string Message { get; set; } = "";

    private void Submit()
    {
        if (Model.EventId is < 1 or > 3)
        {
            Message = "Please enter an event ID from 1 to 3.";
            return;
        }

        Session.StartSession(Model.Name);
        Session.Register(Model.EventId);
        Message = $"{Model.Name} registered successfully for event {Model.EventId}.";
    }

    private sealed class RegistrationModel
    {
        [Required, StringLength(60, MinimumLength = 2)]
        public string Name { get; set; } = "";

        [Required, EmailAddress]
        public string Email { get; set; } = "";

        [Range(1, 3)]
        public int EventId { get; set; } = 1;
    }
}
